{
  "name": "dsh-zotero-research",
  "version": "1.0.0-beta.3",
  "description": "Zotero research reading workbench for DeepSeek Harness: layered reading, evidence checks, research questions and write-back.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "client/client.js",
    "build",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs",
    "examples",
    "licenses",
    "README.en.md",
    "screenshots.json"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "zotero",
    "research",
    "literature-review",
    "pdf",
    "annotations"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node client/build.mjs",
    "build:helper": "sh scripts/build-pdfkit.sh",
    "pack": "node scripts/pack.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs",
    "check:package": "node scripts/install-check.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38"
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhiyingLi-Leo/dsh-zotero-research.git"
  },
  "homepage": "https://github.com/ZhiyingLi-Leo/dsh-zotero-research#readme",
  "bugs": {
    "url": "https://github.com/ZhiyingLi-Leo/dsh-zotero-research/issues"
  },
  "author": "ZhiyingLi-Leo",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "beta"
  }
}
